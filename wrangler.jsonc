{
  // ==========================================================================
  // Little Genius (EduExplore) – Cloudflare Workers 24/7 Production Config
  // Hỗ trợ Cloudflare Workers + Static Assets + D1 + R2 + KV + Cron Triggers
  // ==========================================================================
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "little-genius-eduexplore",
  "main": "worker/index.ts",
  "compatibility_date": "2025-04-01",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  // Phân phối Frontend React + Vite qua Cloudflare CDN + Static Assets
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "APP_ENV": "development",
    "DEPLOYMENT_VERSION": "2.0.0-cloudflare",
    "AI_PROVIDER": "rule_based"
  },
  // Tác vụ nền định kỳ an toàn (dọn dẹp cache lúc 03:00 UTC mỗi ngày)
  "triggers": {
    "crons": ["0 3 * * *"]
  },
  // Cấu hình Cloudflare D1, R2, KV (Điền database_id và id từ tài khoản Cloudflare khi deploy)
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "little-genius-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "little-genius-media-private"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CONFIG_KV",
      "id": "00000000000000000000000000000000"
    }
  ],
  // Môi trường Staging & Production tách biệt
  "env": {
    "staging": {
      "name": "little-genius-staging",
      "vars": {
        "APP_ENV": "staging",
        "DEPLOYMENT_VERSION": "2.0.0-staging",
        "AI_PROVIDER": "rule_based"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "little-genius-db-staging",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA_BUCKET",
          "bucket_name": "little-genius-media-staging"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "CONFIG_KV",
          "id": "00000000000000000000000000000000"
        }
      ]
    },
    "production": {
      "name": "little-genius-production",
      "vars": {
        "APP_ENV": "production",
        "DEPLOYMENT_VERSION": "2.0.0-production",
        "AI_PROVIDER": "rule_based"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "little-genius-db-prod",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA_BUCKET",
          "bucket_name": "little-genius-media-prod"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "CONFIG_KV",
          "id": "00000000000000000000000000000000"
        }
      ]
    }
  }
}
