# ============================================================================
# Little Genius (EduExplore) – Thế giới khám phá của em | Environment Sample
# Không lưu trữ khoá bí mật (secret keys) thật trong tệp mẫu này.
# Với Cloudflare Workers Production, sử dụng `npx wrangler secret put <KEY>`
# ============================================================================

# 1. Chế độ môi trường (development | staging | production)
NODE_ENV=development
APP_ENV=development
APP_VERSION=2.0.0-cloudflare

# 2. Thông tin xác thực Cloudflare (dùng cho CI/CD GitHub Actions hoặc Wrangler CLI)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here

# 3. Cloudflare Turnstile (Chống bot tại màn hình Đăng nhập Phụ huynh & Gửi biểu mẫu)
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=

# 4. Cơ sở dữ liệu PostgreSQL (Tuỳ chọn khi chạy kiến trúc Hybrid/Self-hosted)
# Mặc định trên Cloudflare sử dụng Cloudflare D1 (`migrations/0001_little_genius_schema.sql`)
DATABASE_URL=postgresql://eduexplore_user:change_me_password@localhost:5432/eduexplore_db

# 5. Cấu hình Trợ giảng AI Gợi mở (Socratic AI Learning Assistant)
# Mặc định sử dụng Rule-based Socratic Engine an toàn 100% deterministically.
# Tuyệt đối KHÔNG thêm tiền tố VITE_ hoặc NEXT_PUBLIC_ cho AI_API_KEY.
AI_PROVIDER=rule_based
AI_API_KEY=
AI_MODEL_NAME=gemini-2.5-flash

# 6. Bảo vệ dữ liệu trẻ em & Quyền riêng tư (Child Safety & Privacy-by-Design)
ENABLE_CHILD_SAFETY_FILTER=true
ALLOW_EXTERNAL_TELEMETRY=false
MAX_DAILY_STUDY_MINUTES_DEFAULT=45
DEFAULT_CREATIVE_VISIBILITY=private
