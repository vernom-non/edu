# ============================================================================
# Little Genius (EduExplore) – Thế giới khám phá của em | Environment Sample
# Không lưu trữ khoá bí mật (secret keys) thật trong tệp mẫu này.
# Với Supabase Production, cấu hình trên Supabase Dashboard → Settings → API
# ============================================================================

# 1. Chế độ môi trường (development | staging | production)
NODE_ENV=development
APP_ENV=development
APP_VERSION=2.0.0-supabase

# 2. Supabase Configuration (Lấy tại Supabase Dashboard → Project Settings → API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# 3. Supabase Service Role Key (CHỈ dùng server-side/Edge Functions, KHÔNG commit lên client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# 4. Supabase Storage Bucket (dùng cho media dự án sáng tạo trẻ em)
SUPABASE_STORAGE_BUCKET=little-genius-media

# 5. Cloudflare Turnstile (Chống bot tại màn hình Đăng nhập Phụ huynh & Gửi biểu mẫu)
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=

# 6. Cấu hình Trợ giảng AI Gợi mở (Socratic AI Learning Assistant)
# Mặc định sử dụng Rule-based Socratic Engine an toàn 100% deterministically.
AI_PROVIDER=rule_based
AI_API_KEY=
AI_MODEL_NAME=gemini-2.5-flash

# 7. Bảo vệ dữ liệu trẻ em & Quyền riêng tư (Child Safety & Privacy-by-Design)
ENABLE_CHILD_SAFETY_FILTER=true
ALLOW_EXTERNAL_TELEMETRY=false
MAX_DAILY_STUDY_MINUTES_DEFAULT=45
DEFAULT_CREATIVE_VISIBILITY=private
